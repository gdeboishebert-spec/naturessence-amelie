Options -Indexes
RewriteEngine On

# Redirect index.html and /index to root /
RewriteRule ^index\.html$ / [R=301,L,NE]
RewriteRule ^index$ / [R=301,L,NE]

# Redirect /blog/ (directory) to /blog.html internally
RewriteRule ^blog/?$ /blog.html [L]

# Redirect .html URLs to clean URLs (301 permanent)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Serve .html files internally for clean URLs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]
